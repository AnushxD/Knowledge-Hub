<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Implementations stay internal; test projects are the exception. -->
    <InternalsVisibleTo Include="DocHub.Services.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocHub.DataAccess\DocHub.DataAccess.csproj" />
    <ProjectReference Include="..\DocHub.Integrations\DocHub.Integrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <!-- Encrypts the repository access token and webhook secret before they are
         written to the database. Abstractions only: the key ring is the host's
         to configure, and Authentication:KeyPath is what makes it durable. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.10" />
    <!-- Text extraction. These are in-process parsing libraries, not external
         systems, so they stay in the Service layer behind ITextExtractor rather
         than becoming Integrations. -->
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
