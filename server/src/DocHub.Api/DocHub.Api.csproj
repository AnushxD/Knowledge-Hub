<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Optional external sign-in. Registered only when configuration turns it
         on, so a deployment without Google credentials is unaffected. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <!-- The UI only. Document generation stays with Microsoft.AspNetCore.OpenApi
         above — pulling in full Swashbuckle would run a second, competing
         generator over the same controllers. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <!-- Background ingestion. Runs in-process for now; the same job logic moves
         to a dedicated worker later by pointing Hangfire at another store. -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kept out of the publish output. It is safe in the repository because it
         only points at containers on one machine, but it also carries the local
         seed-admin password — and a deployable artefact has no business
         containing a credential at all. Still copied for `dotnet run`, which
         reads it from the project directory. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />

    <!-- The database setup script travels with the artefact.
         Whoever installs on the server needs it and has no .NET SDK to generate
         it with, so shipping it inside the published folder means the schema is
         always the one that matches these binaries — rather than a file someone
         has to remember to copy across, and later to keep in step.
         Link, because the script lives at the repository root: it is a
         deployment artefact, not something this project owns. -->
    <Content Include="..\..\..\documenthub-schema.sql"
             Link="documenthub-schema.sql"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocHub.Services\DocHub.Services.csproj" />
    <ProjectReference Include="..\DocHub.DataAccess\DocHub.DataAccess.csproj" />
    <ProjectReference Include="..\DocHub.Integrations\DocHub.Integrations.csproj" />
  </ItemGroup>

</Project>
