{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Shape and defaults only — never real values. Local values live in
  // appsettings.Development.json; production values come from environment
  // variables or Key Vault, and secrets from `dotnet user-secrets`.
  "Database": {
    "ConnectionString": ""
  },
  // "ServiceVersion" pins the storage REST API version, e.g. "2024-08-04".
  // Empty uses the SDK default. Set it only against an Azurite too old for the
  // SDK, which rejects newer versions with "InvalidHeaderValue".
  "FileStorage": {
    "ConnectionString": "",
    "ContainerName": "documents",
    "ServiceVersion": ""
  },
  // "Dimensions" must match the width document_chunks.embedding was migrated
  // with — changing model needs a migration and a full re-index.
  "Embeddings": {
    "Provider": "ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "nomic-embed-text",
    "Dimensions": 768,
    "KeepAlive": "30m"
  },
  // The model that writes answers. Separate from "Embeddings" on purpose —
  // retrieval and generation are different jobs and get swapped independently.
  // "ContextTokens" must hold the rules, the passages and the replayed
  // conversation. Ollama's own default is 2048 and it drops the overflow
  // silently, which shows up as an assistant that answers without citations.
  // "KeepAlive" holds the model in memory between questions. Ollama's own
  // default is 5 minutes, so the first question after a quiet spell pays a
  // full reload — about 3 seconds for a 3B model — before answering starts.
  "Llm": {
    "Provider": "ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.2:3b",
    "ContextTokens": 8192,
    "KeepAlive": "30m"
  },
  // Bodies of knowledge the assistant may ground an answer in, beyond the hub's
  // own documents.
  // "RepositoryProvider": "none" uses the stub that contributes nothing; "mcp"
  // searches a real MCP server. "RepositoryToolName" empty discovers the first
  // tool with "search" in its name, which is a guess — name it once known.
  // The address is also editable by an admin on the /sources screen, and an
  // override saved there wins over "RepositoryEndpoint".
  // Repository sources. "RepositoryProvider": "mcp" turns on one knowledge
  // source per entry in "Repositories" — each searched concurrently under its
  // own deadline, each named separately on an answer it could not contribute
  // to. "Name" keys the administrator's override and appears in the API route,
  // so renaming one abandons its override rather than moving it.
  "KnowledgeSources": {
    "RepositoryProvider": "none",
    "Repositories": [],
    "RepositoryMaxResults": 8
  },
  // Sign-in. "Google:ClientSecret" is the one real secret here — it belongs in
  // `dotnet user-secrets` or Key Vault, never in this file. "AllowedDomains"
  // is the access gate for Google sign-in and fails closed when empty.
  "Authentication": {
    "SessionHours": 8,
    "Google": {
      "Enabled": false,
      "ClientId": "",
      "AllowedDomains": [],
      "AutoProvision": true
    }
  },
  // How long any one knowledge source may take before the answer goes ahead
  // without it. Not a latency target — the point past which waiting is worse
  // than answering from the sources that did reply.
  "Knowledge": {
    "SourceTimeoutSeconds": 10
  },
  // Only generation is limited: it is the one endpoint that occupies a model
  // for seconds at a time. Counted per user, not per address.
  "RateLimits": {
    "ChatRequests": 10,
    "ChatWindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
