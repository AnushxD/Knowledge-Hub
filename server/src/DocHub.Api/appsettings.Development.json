{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Local development only. Safe to commit: these point at the docker-compose
  // containers and contain no real credentials.
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=dochub;Username=dochub;Password=dochub_local_dev"
  },
  "FileStorage": {
    // Resolved by the Azure SDK to the local Azurite emulator.
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "documents"
  },
  // Points at the docker-compose Ollama container. Set "Provider" to "hashing"
  // to run the pipeline with no model at all — see the README.
  "Embeddings": {
    "Provider": "ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "nomic-embed-text",
    "Dimensions": 768
  },
  "Llm": {
    "Provider": "ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.2:3b"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  }
}
