<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting configuration, copied into the publish output.

  `dotnet publish` generates a minimal web.config on its own; this one replaces
  it because two of the settings below are not defaults and the app is wrong
  without them.

  Deployment on the org Windows box, in order:
    1. Install the ASP.NET Core Hosting Bundle (this file is useless without
       the AspNetCoreModuleV2 it registers).
    2. Create a site pointing at the published folder, with an application pool
       set to "No Managed Code" — the runtime is in the app, not in IIS.
    3. Grant the pool identity read access to the folder, and write access only
       to logs\ if stdout logging is turned on below.
    4. Provisioning is still explicit and still the operator's: apply
       migrations, then `DocHub.Api.exe init-storage` and
       `DocHub.Api.exe seed-admin`.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet"
                arguments=".\DocHub.Api.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess"
                requestTimeout="00:10:00">
      <!--
        The assistant streams its answer as server-sent events. The ASP.NET
        Core Module buffers the response by default, which does not fail — it
        just holds the whole answer and delivers it at the end, turning a
        stream into a slow request. Zero disables the buffer.

        This is the IIS counterpart of `proxy_buffering off` in the nginx
        config; the same mistake is available in both places.
      -->
      <handlerSettings>
        <handlerSetting name="responseBufferLimit" value="0" />
      </handlerSettings>

      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>

    <security>
      <requestFiltering>
        <!--
          25 MB, matching the limit the service and Kestrel already enforce.
          IIS's own default is ~28.6 MB and is checked first, so leaving it
          would mean a file between the two limits is rejected by IIS with a
          bare 404.13 instead of the API's explanation.
        -->
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- IIS advertises itself by default; there is nothing to gain by
             telling every caller which server and version to look up. -->
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
