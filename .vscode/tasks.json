{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/server/DocHub.slnx"],
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "infra-up",
      "detail": "Start Postgres + Azurite before the API needs them.",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "-d", "--wait"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "api-ready",
      "detail": "Bring infra up, then build. Chained so F5 never races the containers.",
      "dependsOrder": "sequence",
      "dependsOn": ["infra-up", "build-api"],
      "problemMatcher": []
    },
    {
      "label": "ng-serve",
      "type": "shell",
      "command": "npm",
      "args": ["start"],
      "options": { "cwd": "${workspaceFolder}/client" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "typescript",
        "source": "ts",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(.*?)Building(.*?)",
          "endsPattern": "(.*?)(Watch mode enabled|Application bundle generation complete)(.*?)"
        }
      }
    }
  ]
}
